# ============================================================================
# KONFIGURASI BACKEND - Aplikasi Absensi PKL (PostgreSQL / Supabase)
# ============================================================================
# Salin file ini menjadi .env untuk development lokal.
# Untuk production (Railway), set variabel yang sama di dashboard Railway.

# ----- Koneksi PostgreSQL (Supabase) -----
# Ambil dari: Supabase Dashboard → tombol "Connect" → Session pooler → URI
# (Session pooler = IPv4, cocok untuk Railway & laptop; ganti [PASSWORD]
#  dan [PROJECT-REF] sesuai project kamu)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Alternatif tanpa DATABASE_URL (misal PostgreSQL lokal):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=pkl
# PGSSL=false

# ----- JWT -----
# Generate random string minimal 32 karakter:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters

# ----- Server -----
# Railway otomatis set PORT; lokal default 5000
PORT=5000
NODE_ENV=development

# ============================================================================
# BYPASS FLAGS (untuk testing / UAT online)
# ============================================================================
# true = absen bisa dari jaringan mana pun (tidak wajib WiFi kampus 103.209.9.x)
BYPASS_WIFI_CHECK=true

# true = abaikan jendela jam absen (08-10 & 15-17);
#        sesi otomatis: pagi dulu, lalu sore
BYPASS_TIME_CHECK=true

# true = lewati aturan jeda minimal 6 jam antara absen pagi & sore
BYPASS_JEDA_CHECK=true

# true = paksa sesi selalu "pagi" (hati-hati: tidak bisa absen sore)
# BYPASS_PAGI_ONLY=true

# ----- Bypass sisi frontend (dibaca saat BUILD client) -----
# Menampilkan mode bypass di UI dashboard mahasiswa
VITE_BYPASS_TIME_CHECK=true
# VITE_BYPASS_PAGI_ONLY=true

# ----- Upload folder -----
# Lokal: server/uploads/ (default)
# Railway: arahkan ke mount path Volume, mis. /app/server/uploads
# UPLOAD_ROOT=uploads