# ============================================================================
# TEMPLATE ENVIRONMENT VARIABLES UNTUK RAILWAY (PRODUCTION)
# ============================================================================
# Paste variabel di bawah ini ke: Railway → service → Variables
# (jangan commit password asli ke GitHub!)
#
# File ini TIDAK dibaca otomatis oleh server — hanya template referensi.
# ============================================================================

NODE_ENV=production

# Supabase: tombol "Connect" → Session pooler → URI (IPv4, aman untuk Railway)
# Ganti [PROJECT-REF], [YOUR-PASSWORD], [REGION] sesuai project kamu.
# Jangan pakai "Transaction pooler" (port 6543) — timezone sesi bisa tidak konsisten.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=[RANDOM-SECRET-MIN-32-CHAR]

# Bypass untuk UAT online (absen dari mana saja, kapan saja)
BYPASS_WIFI_CHECK=true
BYPASS_TIME_CHECK=true
BYPASS_JEDA_CHECK=true

# Frontend build flags (Railway meng-oper variables sebagai build args)
VITE_BYPASS_TIME_CHECK=true

# Uploads: mount Railway Volume di /app/server/uploads
UPLOAD_ROOT=/app/server/uploads